{
    "name": "muni-graneros/laravel-muni-ui",
    "description": "Sistema de diseño y componentes Blade del ecosistema municipal de Graneros (tokens oklch, temas dark/light, componentes de panel de datos).",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "require-dev": {
        "filament/filament": "^5.0",
        "muni-graneros/laravel-muni-shared": "^1.14",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Muni\\Ui\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Muni\\Ui\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Muni\\Ui\\MuniUiServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "filament/filament": "Para usar el plugin MuniPanel que viste los paneles con la identidad municipal."
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "repositories": {
        "muni-shared": {
            "type": "vcs",
            "url": "https://github.com/muni-graneros/laravel-muni-shared.git",
            "no-api": true
        }
    },
    "scripts": {
        "test": "pest"
    }
}
